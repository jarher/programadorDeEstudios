# =====================================================================
# StudyProgrammer - Reglas de exclusion del repositorio
# Repo: https://github.com/jarher/programadorDeEstudios
# =====================================================================

# ---------------------------------------------------------------------
# .NET / compilacion / Visual Studio
# ---------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Pp]ublish/
[Pp]ackages/
artifacts/
.artifacts/
*.binlog
*.buildlog
*.msbuild.log
msbuild.log
project.lock.json
project.fragment.lock.json

# Salidas de Visual Studio / Rider
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
*.VC.db
*.VC.VC.opendb
_ReSharper*/
*.resharper

# ---------------------------------------------------------------------
# Paquetes NuGet
# ---------------------------------------------------------------------
*.nupkg
*.snupkg
.nuget/
global-packages/
nuget-packages/

# ---------------------------------------------------------------------
# Pruebas y cobertura
# ---------------------------------------------------------------------
TestResults/
*.trx
*.coverage
*.coveragexml
coverage/
coverage.*
*.cobertura.xml
BenchmarkDotNet.Artifacts/

# ---------------------------------------------------------------------
# Base de datos local SQLite (nunca versionar datos del usuario)
# La app usa %LOCALAPPDATA%\StudyTracker\study_tracker.db
# ---------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
study_tracker.db*

# ---------------------------------------------------------------------
# Node.js / npx (MCP git-mcp-server y tooling auxiliar)
# ---------------------------------------------------------------------
node_modules/
.npm/
.npx/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# Python / uvx (MCP alternativo basado en Python)
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------
# Logs de los servidores MCP y de la aplicacion
# ---------------------------------------------------------------------
logs/
.mcp/
mcp-*.log
*-mcp.log

# ---------------------------------------------------------------------
# Secretos y configuracion local (no versionar)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local
*.local.json
secrets/
*.pfx
*.snk
*.pem
*.key

# ---------------------------------------------------------------------
# Archivos temporales de OneDrive / Windows / editores
# ---------------------------------------------------------------------
~$*
*.tmp
*.temp
*.bak
*.orig
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---------------------------------------------------------------------
# Nota: los scripts de .specify/scripts/powershell/ SI se versionan.
# ---------------------------------------------------------------------
