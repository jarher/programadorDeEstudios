<ui:FluentWindow x:Class="StudyTracker.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="StudyProgrammer"
                 Width="1120"
                 Height="720"
                 MinWidth="900"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 TextOptions.TextFormattingMode="Display"
                 UseLayoutRounding="True">
    <ui:FluentWindow.Resources>
        <Style x:Key="DisplayTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="46" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="LeadText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="NavMuted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="StudyProgrammer"
                     ShowHelp="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BookOpen24" Filled="True" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="ThemeButton"
                           Appearance="Transparent"
                           Padding="8"
                           Margin="0,0,8,0"
                           Click="ThemeButton_Click"
                           ToolTip="Cambiar tema"
                           AutomationProperties.Name="Cambiar tema">
                    <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherMoon24" FontSize="16" />
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,22,24,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="12"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <ui:SymbolIcon Symbol="BookOpen24"
                                               FontSize="20"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="StudyProgrammer" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Estudio consciente" Style="{StaticResource MetaText}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="16,32,16,0">
                        <TextBlock Text="ESPACIO DE TRABAJO"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="8,0,8,8" />

                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24"
                                               FontSize="18"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Dashboard"
                                           Style="{StaticResource NavLabel}"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" Padding="12,10" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Timer24"
                                               FontSize="18"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="Temporizador"
                                           Style="{StaticResource NavMuted}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Pronto"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" Padding="12,10" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataBarVertical24"
                                               FontSize="18"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="Analítica"
                                           Style="{StaticResource NavMuted}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Pronto"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="16,0,16,20"
                            Padding="14"
                            CornerRadius="10"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="FASE 3" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Base Fluent activa"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,2" />
                            <TextBlock Text="Mica y tema adaptable listos."
                                       Style="{StaticResource MetaText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="40,28,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="PANEL DE ESTUDIO" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Tu progreso, en un solo lugar."
                               Style="{StaticResource DisplayTitle}"
                               MaxWidth="640"
                               HorizontalAlignment="Left"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Un espacio sereno para organizar temáticas, sostener el enfoque y ver cómo avanzas día a día."
                               Style="{StaticResource LeadText}"
                               MaxWidth="600"
                               HorizontalAlignment="Left"
                               Margin="0,12,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,32,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="296" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" VerticalAlignment="Top">
                        <StackPanel Margin="28">
                            <Border Width="56"
                                    Height="56"
                                    CornerRadius="16"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <ui:SymbolIcon Symbol="Sparkle24"
                                               FontSize="24"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="La base visual está lista"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,20,0,0" />
                            <TextBlock Text="La ventana Fluent, el fondo Mica y el cambio de tema ya están activos. El dashboard de temáticas llega en las próximas tareas."
                                       Style="{StaticResource LeadText}"
                                       Margin="0,8,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="6"
                                        Padding="10,4">
                                    <TextBlock Text="Fase 3"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Siguiente: dashboard y temáticas"
                                           Style="{StaticResource MetaText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                        <StackPanel Margin="24">
                            <TextBlock Text="ENTORNO VISUAL" Style="{StaticResource SectionLabel}" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <ui:SymbolIcon Symbol="WeatherMoon24"
                                               FontSize="18"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Tema adaptable" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Claro u oscuro, al instante." Style="{StaticResource MetaText}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ui:SymbolIcon Symbol="Layer24"
                                               FontSize="18"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Mica" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Fondo translúcido de Windows 11." Style="{StaticResource MetaText}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ui:SymbolIcon Symbol="Window24"
                                               FontSize="18"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Ventana Fluent" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Controles y tipografía nativos." Style="{StaticResource MetaText}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
