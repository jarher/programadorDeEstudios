<ui:FluentWindow x:Class="StudyTracker.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:StudyTracker.UI.Views"
                 mc:Ignorable="d"
                 Title="StudyProgrammer"
                 Width="1120"
                 Height="720"
                 MinWidth="900"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 TextOptions.TextFormattingMode="Display"
                 UseLayoutRounding="True">
    <ui:FluentWindow.Resources>
        <Style x:Key="DisplayTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="46" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="LeadText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="NavMuted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="StudyProgrammer"
                     ShowHelp="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BookOpen24" Filled="True" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="ThemeButton"
                           Appearance="Transparent"
                           Padding="8"
                           Margin="0,0,8,0"
                           Click="ThemeButton_Click"
                           ToolTip="Cambiar tema"
                           AutomationProperties.Name="Cambiar tema">
                    <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherMoon24" FontSize="16" />
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,22,24,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="12"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <ui:SymbolIcon Symbol="BookOpen24"
                                               FontSize="20"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="StudyProgrammer" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Estudio consciente" Style="{StaticResource MetaText}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="16,32,16,0">
                        <TextBlock Text="ESPACIO DE TRABAJO"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="8,0,8,8" />

                        <!-- Opción Dashboard -->
                        <Border CornerRadius="8" Margin="0,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDashboardActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:Button Command="{Binding NavigateToCommand}"
                                       CommandParameter="Dashboard"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Padding="12,10"
                                       AutomationProperties.Name="Ir al Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Home24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="Dashboard"
                                               Style="{StaticResource NavLabel}"
                                               FontWeight="SemiBold"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Border>

                        <!-- Opción Temporizador -->
                        <Border CornerRadius="8" Margin="0,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimerActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:Button Command="{Binding NavigateToCommand}"
                                       CommandParameter="Timer"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Padding="12,10"
                                       AutomationProperties.Name="Ir al Temporizador">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Timer24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="Temporizador"
                                               Style="{StaticResource NavLabel}"
                                               FontWeight="SemiBold"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Border>

                        <!-- Opción Analítica -->
                        <Border CornerRadius="8" Margin="0,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatsActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:Button Command="{Binding NavigateToCommand}"
                                       CommandParameter="Stats"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Padding="12,10"
                                       AutomationProperties.Name="Ir a Analítica">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DataBarVertical24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="Analítica"
                                               Style="{StaticResource NavLabel}"
                                               FontWeight="SemiBold"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Área de Vistas Principales -->
            <Grid Grid.Column="1" Margin="40,28,40,32">
                <!-- Vista del Dashboard -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDashboardActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:DashboardView DataContext="{Binding Dashboard}" />
                </Grid>

                <!-- Vista del Temporizador -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTimerActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:TimerView x:Name="TimerControl" DataContext="{Binding Timer}" />
                </Grid>

                <!-- Vista del Mapa de Calor -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatsActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:StatsView DataContext="{Binding Stats}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
