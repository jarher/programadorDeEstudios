<UserControl x:Class="StudyTracker.UI.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="DisplayTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="HeatmapCell" TargetType="Border">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Tooltip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInRange}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IntensityLevel}" Value="1">
                    <Setter Property="Background" Value="#B8D9F0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IntensityLevel}" Value="2">
                    <Setter Property="Background" Value="#79B7DE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IntensityLevel}" Value="3">
                    <Setter Property="Background" Value="#378CC4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IntensityLevel}" Value="4">
                    <Setter Property="Background" Value="#0F6CBD" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Tu ritmo de estudio" Style="{StaticResource DisplayTitle}" />
            <TextBlock Text="Cada casilla muestra cuánto estudiaste en un día. El color más intenso representa más tiempo."
                       Style="{StaticResource MetaText}"
                       FontSize="14"
                       Margin="0,8,0,24" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Racha actual" Style="{StaticResource MetaText}" />
                        <TextBlock Text="{Binding StreakText}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="1"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Margin="20,2" />
                    <StackPanel Grid.Column="2" MinWidth="110">
                        <TextBlock Text="Tiempo estudiado" Style="{StaticResource MetaText}" />
                        <TextBlock Text="{Binding StudyTimeText}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,18">
                        <ui:Button DockPanel.Dock="Right"
                                   Content="Actualizar"
                                   Appearance="Transparent"
                                   Command="{Binding LoadCommand}"
                                   AutomationProperties.Name="Actualizar estadísticas">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <StackPanel>
                            <TextBlock Text="Actividad diaria"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DateRangeText}"
                                       Style="{StaticResource MetaText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,20,6,0">
                                <TextBlock Text="lun"
                                           Style="{StaticResource MetaText}"
                                           Height="17" />
                                <TextBlock Text="mar"
                                           Style="{StaticResource MetaText}"
                                           Height="17" />
                                <TextBlock Text="mié"
                                           Style="{StaticResource MetaText}"
                                           Height="17" />
                                <TextBlock Text="jue"
                                           Style="{StaticResource MetaText}"
                                           Height="17" />
                                <TextBlock Text="vie"
                                           Style="{StaticResource MetaText}"
                                           Height="17" />
                                <TextBlock Text="sáb"
                                           Style="{StaticResource MetaText}"
                                           Height="17" />
                                <TextBlock Text="dom"
                                           Style="{StaticResource MetaText}"
                                           Height="17" />
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Weeks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="18">
                                            <TextBlock Text="{Binding MonthLabel}"
                                                       Style="{StaticResource MetaText}"
                                                       Height="20"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ItemsControl ItemsSource="{Binding Days}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource HeatmapCell}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <TextBlock Text="Menos" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Style="{StaticResource HeatmapCell}" Margin="0,0,4,0" />
                        <Border Style="{StaticResource HeatmapCell}" Background="#B8D9F0" Margin="0,0,4,0" />
                        <Border Style="{StaticResource HeatmapCell}" Background="#79B7DE" Margin="0,0,4,0" />
                        <Border Style="{StaticResource HeatmapCell}" Background="#378CC4" Margin="0,0,4,0" />
                        <Border Style="{StaticResource HeatmapCell}" Background="#0F6CBD" Margin="0,0,8,0" />
                        <TextBlock Text="Más" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Aún no hay sesiones en este período. Inicia un bloque de estudio para llenar el mapa."
                               Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStudyActivity}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Tiempo por temática"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TopicsWithStudyTimeText}"
                                   Style="{StaticResource MetaText}"
                                   Margin="0,3,0,0" />
                        <lvc:PieChart Series="{Binding TopicDistributionSeries}"
                                      Height="210"
                                      Margin="0,8,0,4"
                                      AutomationProperties.Name="Gráfica de dona: distribución del tiempo de estudio por temática">
                            <lvc:PieChart.Style>
                                <Style TargetType="{x:Type lvc:PieChart}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTopicDistribution}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </lvc:PieChart.Style>
                        </lvc:PieChart>
                        <ItemsControl ItemsSource="{Binding TopicDistributionLegend}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding Title}" />
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding Title}">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding StudyTimeText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PercentageText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Registra una sesión para ver cómo se reparte tu tiempo."
                                   Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTopicDistribution}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Avance de metas"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TopicsWithGoalsText}"
                                   Style="{StaticResource MetaText}"
                                   Margin="0,3,0,0" />
                        <lvc:CartesianChart Series="{Binding GoalProgressSeries}"
                                            XAxes="{Binding GoalXAxes}"
                                            YAxes="{Binding GoalYAxes}"
                                            Height="{Binding GoalChartHeight}"
                                            Margin="0,8,0,4"
                                            AutomationProperties.Name="Gráfica de barras: avance hacia las metas de estudio">
                            <lvc:CartesianChart.Style>
                                <Style TargetType="{x:Type lvc:CartesianChart}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGoals}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </lvc:CartesianChart.Style>
                        </lvc:CartesianChart>
                        <ItemsControl ItemsSource="{Binding TopicGoalProgress}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ProgressPercentage, StringFormat={}{0:0.#}%}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="12"
                                                       ToolTip="{Binding Title}" />
                                        </DockPanel>
                                        <ProgressBar Grid.Row="1"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercentage}"
                                                     Height="5"
                                                     Margin="0,4,0,0"
                                                     Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                     Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                     AutomationProperties.Name="{Binding Title}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Añade una meta de horas a una temática para seguir su avance."
                                   Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGoals}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
