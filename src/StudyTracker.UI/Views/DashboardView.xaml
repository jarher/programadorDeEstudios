<UserControl x:Class="StudyTracker.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:StudyTracker.UI.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />
        <converters:InverseBooleanConverter x:Key="InverseBoolean" />

        <Style x:Key="DashboardCard" TargetType="ui:Card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Card">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DisplayTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="46" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="LeadText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Description}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusChipText" TargetType="TextBlock">
            <Setter Property="Text" Value="Activa" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Text" Value="Completada" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                    <Setter Property="Text" Value="Archivada" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopicCard" TargetType="ui:Card" BasedOn="{StaticResource DashboardCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionNotes" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Notes}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionNoNotes" TargetType="TextBlock">
            <Setter Property="Text" Value="Sin notas para esta sesión" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Notes}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopicProgressBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTarget}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrorBanner" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="PANEL DE ESTUDIO" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Tu progreso, en un solo lugar."
                       Style="{StaticResource DisplayTitle}"
                       MaxWidth="640"
                       HorizontalAlignment="Left"
                       Margin="0,8,0,0" />
            <TextBlock Text="Un espacio sereno para organizar temáticas, sostener el enfoque y ver cómo avanzas día a día."
                       Style="{StaticResource LeadText}"
                       MaxWidth="600"
                       HorizontalAlignment="Left"
                       Margin="0,12,0,0" />
            <TextBlock Text="{Binding SummaryHeadline}"
                       FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="ErrorCircle24"
                               FontSize="18"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               VerticalAlignment="Top" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,24,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Style="{StaticResource DashboardCard}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalTopics}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Total de temáticas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveTopics}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Activas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="4" Style="{StaticResource DashboardCard}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding CompletedTopics}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Completadas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="6" Style="{StaticResource DashboardCard}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalHoursStudied, StringFormat='{}{0:0.0}'}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Horas estudiadas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ui:Card Style="{StaticResource DashboardCard}" Padding="20,16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PROGRESO GENERAL" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding OverallProgressText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding OverallProgressPercentage, StringFormat='{}{0:0} %'}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />
                    </Grid>
                    <ProgressBar Value="{Binding OverallProgressPercentage, Mode=OneWay}"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="8"
                                 Margin="0,12,0,0"
                                 Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                 Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                 BorderThickness="0"
                                 AutomationProperties.Name="Progreso general" />
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Margin="2,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="TEMÁTICAS"
                           Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center" />

                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           Padding="12,6"
                           Click="AddTopic_Click"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                           KeyboardNavigation.TabIndex="0"
                           AutomationProperties.Name="Añadir nueva temática">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24"
                                       FontSize="14"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="Nueva temática"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <Grid Grid.Column="0" Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              Visibility="{Binding HasTopics, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Topics}"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button Grid.Column="0"
                                               Appearance="Transparent"
                                               Padding="0"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Stretch"
                                               Click="TopicDetails_Click"
                                               AutomationProperties.Name="{Binding Title, StringFormat='Ver detalles de {0}'}">
                                        <ui:Card Style="{StaticResource TopicCard}"
                                                 Padding="16,14">
                                            <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="4"
                                                CornerRadius="2"
                                                Margin="0,2,0,2"
                                                VerticalAlignment="Stretch"
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />

                                        <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource StatusChip}"
                                                        Margin="12,0,0,0">
                                                    <TextBlock Style="{StaticResource StatusChipText}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource DescriptionText}" />

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding StudiedTimeText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="·"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Margin="8,0" />
                                                <TextBlock Text="{Binding TargetText}"
                                                           Style="{StaticResource MetaText}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Style="{StaticResource TopicProgressBar}"
                                                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                             Margin="0,0,12,0"
                                                             AutomationProperties.Name="Progreso de la temática" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProgressText}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>

                                            </Grid>
                                        </ui:Card>
                                    </ui:Button>

                                    <CheckBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,12"
                                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolean}}"
                                              ToolTip="Marcar o desmarcar como completada"
                                              AutomationProperties.Name="{Binding Title, StringFormat='Marcar {0} como completada'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="360"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="16"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <ui:SymbolIcon Symbol="BookAdd24"
                                       FontSize="26"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Aún no hay temáticas"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Crea tu primera temática para empezar a registrar horas de estudio y ver tu progreso aquí."
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,6,0,0" />
                    <ui:Button Appearance="Primary"
                               Content="Crear la primera temática"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"
                               Click="AddTopic_Click"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                               KeyboardNavigation.TabIndex="1"
                               AutomationProperties.Name="Crear la primera temática" />
                </StackPanel>

                <ui:ProgressRing Width="40"
                                 Height="40"
                                 IsIndeterminate="True"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>

            <ui:Card Grid.Column="1"
                     Grid.RowSpan="2"
                     Width="300"
                     Padding="0"
                     Margin="16,0,0,0"
                     Style="{StaticResource DashboardCard}"
                     AutomationProperties.Name="{Binding SelectedTopic.Title, StringFormat='Detalle de temática: {0}'}"
                     Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DETALLE DE TEMÁTICA"
                                           Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding SelectedTopic.Title}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Appearance="Transparent"
                                       Padding="6"
                                       Command="{Binding ClearSelectedTopicCommand}"
                                       ToolTip="Cerrar detalle"
                                       AutomationProperties.Name="Cerrar detalle de temática">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                            </ui:Button>
                        </Grid>

                        <Border Height="3"
                                CornerRadius="2"
                                Background="{Binding SelectedTopic.ColorHex, Converter={StaticResource HexToBrush}}"
                                Margin="0,14,0,12" />

                        <Border DataContext="{Binding SelectedTopic}"
                                Style="{StaticResource StatusChip}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <TextBlock DataContext="{Binding SelectedTopic}"
                                   Text="{Binding Description}"
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,12,0,0" />

                        <TextBlock Text="RESUMEN"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Estudiado" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding SelectedTopic.StudiedTimeText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,3,8,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Meta" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding SelectedTopic.TargetText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar Style="{StaticResource TopicProgressBar}"
                                     Value="{Binding SelectedTopic.ProgressPercentage, Mode=OneWay}"
                                     Margin="0,10,0,0"
                                     AutomationProperties.Name="Progreso de la temática seleccionada" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Iniciada" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding SelectedTopic.CreatedAt, StringFormat='{}{0:dd MMM yyyy}'}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,8,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Completada" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding SelectedTopic.CompletedAt, TargetNullValue='Pendiente', StringFormat='{}{0:dd MMM yyyy}'}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Último estudio"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{Binding SelectedTopic.LastStudiedAt, TargetNullValue='Sin sesiones', StringFormat='{}{0:dd MMM yyyy, HH:mm}'}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />

                        <Grid Margin="0,20,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HISTORIAL Y NOTAS"
                                       Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" />
                            <ui:ProgressRing Grid.Column="1"
                                             Width="18"
                                             Height="18"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsLoadingSelectedTopic, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Visibility="{Binding HasSelectedTopicError, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{Binding SelectedTopicErrorMessage}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Border>

                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="10"
                                Visibility="{Binding HasNoSelectedSessions, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="Esta temática aún no tiene sesiones de estudio registradas."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding SelectedSessions}"
                                      Visibility="{Binding HasSelectedSessions, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:dd MMM yyyy · HH:mm}'}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding ActualMinutes, StringFormat='{}{0} min estudiados'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding PlannedMinutes, StringFormat='{}{0} min planificados'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Notes}"
                                                       Style="{StaticResource SessionNotes}" />
                                            <TextBlock Style="{StaticResource SessionNoNotes}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
