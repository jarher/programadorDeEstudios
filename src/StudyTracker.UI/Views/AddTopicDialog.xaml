<ui:FluentWindow x:Class="StudyTracker.UI.Views.AddTopicDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:converters="clr-namespace:StudyTracker.UI.Converters"
                 mc:Ignorable="d"
                 Title="Nueva temática"
                 Width="480"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 TextOptions.TextFormattingMode="Display"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Loaded="AddTopicDialog_Loaded">
    <ui:FluentWindow.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ValidationText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ValidationMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaletteItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="32" Height="32" Background="Transparent">
                            <Border x:Name="Ring"
                                    CornerRadius="16"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Nueva temática"
                     ShowHelp="False"
                     ShowMinimize="False"
                     ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,24">
            <TextBlock Text="Registra una temática para organizar tus sesiones de estudio."
                       Style="{StaticResource HelpText}" />

            <TextBlock Text="TÍTULO" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="TitleTextBox"
                        Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="120"
                        AutomationProperties.Name="Título de la temática" />

            <TextBlock Text="DESCRIPCIÓN (OPCIONAL)" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="400"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="76"
                        VerticalScrollBarVisibility="Auto"
                        AutomationProperties.Name="Descripción de la temática" />

            <TextBlock Text="META DE HORAS" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            Width="120"
                            MaxLength="8"
                            Text="{Binding TargetHoursText, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Meta de horas" />
                <TextBlock Grid.Column="1"
                           Text="0 = sin meta"
                           Style="{StaticResource HelpText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>

            <TextBlock Text="COLOR" Style="{StaticResource FieldLabel}" />
            <ListBox ItemsSource="{Binding Palette}"
                     SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource PaletteItem}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="Cycle">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock Text="{Binding ValidationMessage}"
                       Style="{StaticResource ValidationText}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <ui:Button Content="Cancelar"
                           IsCancel="True"
                           Click="Cancel_Click"
                           Margin="0,0,8,0"
                           AutomationProperties.Name="Cancelar" />
                <ui:Button Appearance="Primary"
                           Content="Crear temática"
                           IsDefault="True"
                           IsEnabled="{Binding CanCreate}"
                           Click="Create_Click"
                           AutomationProperties.Name="Crear temática" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
