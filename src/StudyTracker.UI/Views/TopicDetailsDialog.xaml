<ui:FluentWindow x:Class="StudyTracker.UI.Views.TopicDetailsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:converters="clr-namespace:StudyTracker.UI.Converters"
                 mc:Ignorable="d"
                 Title="Detalle de temática"
                 Width="760"
                 Height="700"
                 MinWidth="620"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 TextOptions.TextFormattingMode="Display"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="SessionNotes" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Notes}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionNoNotes" TargetType="TextBlock">
            <Setter Property="Text" Value="Sin notas para esta sesión" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Notes}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Detalle de temática"
                     ShowHelp="False"
                     ShowMinimize="False"
                     ShowMaximize="False" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,28">
                <TextBlock Text="{Binding SelectedTopic.Title}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="30"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <Border Height="4"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        Width="72"
                        Background="{Binding SelectedTopic.ColorHex, Converter={StaticResource HexToBrush}}"
                        Margin="0,12,0,14" />

                <Border DataContext="{Binding SelectedTopic}"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="9,4"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>

                <TextBlock DataContext="{Binding SelectedTopic}"
                           Text="{Binding Description}"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Description}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Resumen"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,24,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Tiempo estudiado" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding SelectedTopic.StudiedTimeText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Meta" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding SelectedTopic.TargetText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Último estudio" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding SelectedTopic.LastStudiedAt, TargetNullValue='Sin sesiones', StringFormat='{}{0:dd MMM yyyy, HH:mm}'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ProgressBar DataContext="{Binding SelectedTopic}"
                             Minimum="0"
                             Maximum="100"
                             Height="7"
                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                             Background="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="0"
                             Margin="0,12,0,0"
                             Visibility="{Binding HasTarget, Converter={StaticResource BooleanToVisibility}}"
                             AutomationProperties.Name="Progreso de la temática" />

                <Grid Margin="0,24,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sesiones y notas"
                               Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center" />
                    <ui:ProgressRing Grid.Column="1"
                                     Width="20"
                                     Height="20"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsLoadingSelectedTopic, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{Binding HasSelectedTopicError, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding SelectedTopicErrorMessage}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </Border>

                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="14"
                        Visibility="{Binding HasNoSelectedSessions, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="Esta temática aún no tiene sesiones de estudio registradas."
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>

                <ItemsControl x:Name="SessionHistory"
                              ItemsSource="{Binding SelectedSessions}"
                              Visibility="{Binding HasSelectedSessions, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:dd MMM yyyy · HH:mm}'}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ActualMinutes, StringFormat='{}{0} min estudiados'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding PlannedMinutes, StringFormat='{}{0} min planificados'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource SessionNotes}" />
                                    <TextBlock Style="{StaticResource SessionNoNotes}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <ui:Button Content="Cerrar"
                       Appearance="Primary"
                       HorizontalAlignment="Right"
                       MinWidth="100"
                       Click="Close_Click"
                       AutomationProperties.Name="Cerrar detalle de temática" />
        </Border>
    </Grid>
</ui:FluentWindow>
